{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:web": "node dist/web/server/server.mjs",
    "check": "npm run fmt:check && npm run lint",
