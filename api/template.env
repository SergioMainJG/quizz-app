# Copy to .env (or run `bun run secrets init`, which also generates the secrets).
APP_NAME=api
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://app:change-me@localhost:5432/app
CACHE_TTL=60000
# valkey speaks the Redis protocol, so the URL uses redis://
CACHE_URL=redis://:change-me@localhost:6379
LOG_LEVEL=info
DOMAIN_ORIGIN=http://localhost:5173
# smtp://user:pass@host:587 - leave empty to log e-mails instead of sending them
# SMTP_URL=
MAIL_FROM=My App <no-reply@example.com>
