    "@nestjs/swagger": "12.1.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.3.2",
    "@scalar/nestjs-api-reference": "1.2.34",
    "@socket.io/bun-engine": "0.1.2",
    "arktype": "2.2.9",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "keyv": "5.6.0",
    "nestjs-pino": "5.3.1",
    "nestjs-platform-bun": "0.1.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "description": "NestJS api generated by nest-project-kit",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/bun": "1.4.4",
    "drizzle-kit": "1.0.0-rc.5",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "name": "api",
  "packageManager": "bun@1.4.3",
  "private": true,
  "scripts": {
    "build": "nest build",
    "check": "bun run fmt:check && bun run lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "secrets": "bun scripts/secrets.ts",
    "start": "nest start --exec bun",
    "start:debug": "nest start --debug --watch --exec bun",
    "start:dev": "nest start --watch --exec bun",
    "start:prod": "bun dist/main.js",
    "test": "bun --bun vitest run --project unit",
    "test:all": "bun --bun vitest run",
    "test:cov": "bun --bun vitest run --coverage",
    "test:e2e": "bun --bun vitest run --project e2e",
    "test:watch": "bun --bun vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
